# ==============================================================================
# RoadAlert Configuration & Twilio Voice Emergency Alert Environment Variables
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-replace-with-a-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.ngrok-free.app,.ngrok.io

# ==============================================================================
# Twilio Voice API Credentials (Programmable Voice)
# Get these from your Twilio Console (https://console.twilio.com)
# ==============================================================================

# Your Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your Twilio Auth Token (keep secret! Never commit to GitHub)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your purchased Twilio phone number or verified Caller ID in E.164 format (e.g. +12065550100)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public HTTPS URL forwarding to port 8000 (Required for Twilio Webhooks/Callbacks)
# When testing locally with ngrok, copy your active forwarding URL here:
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# ==============================================================================
# Safety & Outbound Calling Control
# ==============================================================================

# Set to 'true' to enable LIVE outbound phone calls.
# Keep 'false' for dry-run simulation mode (safely logs and records calls without dialing).
ROADALERT_CALLS_ENABLED=false

# Optional allowlist of verified test phone numbers in development (comma-separated E.164)
# When set, the system will ONLY dial these numbers even if live calls are enabled.
ROADALERT_CALL_ALLOWLIST=+919876543210,+919876543211

# Voice Persona and Language (Twilio supported voices, e.g. 'alice', 'Polly.Aditi', 'Polly.Raveena')
TWILIO_VOICE_NAME=alice
TWILIO_VOICE_LANGUAGE=en-IN
